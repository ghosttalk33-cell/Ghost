# Kopieer dit bestand naar .env en vul in:   cp .env.voorbeeld .env && nano .env
# Deel dit bestand met niemand en zet het nooit online.

# 1. Telegram: maak een bot via @BotFather en plak het token hier
TELEGRAM_TOKEN=

# 2. Jouw Telegram-ID (start de bot zonder, stuur hem een bericht: hij vertelt je je ID)
OWNER_ID=

# 3. Claude (het brein): maak een sleutel op console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# MODEL=claude-opus-5-5

# 4. Gmail (optioneel): je adres + een app-wachtwoord (myaccount.google.com/apppasswords)
MAIL_USER=
MAIL_PASS=

# 5. Afbeeldingen maken (optioneel): sleutel van console.x.ai
XAI_API_KEY=
# XAI_IMAGE_MODEL=grok-imagine-image

# Tijdzone voor taken en herinneringen
TZ=Europe/Amsterdam
